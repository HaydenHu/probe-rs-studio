# Build output and local Cargo cache
/target/
/.cargo/config.toml

# Cargo.lock is generated locally: this project tracks a moving git branch of
# the probe-rs fork, and local development uses a path override instead.
Cargo.lock

# Local runtime state / generated artifacts
probe-rs-studio.exe
probe-rs-studio.json
*.log
*.bin
*.bmp
*.hex
*.elf

# Throwaway GUI smoke-test captures and helper scripts
_tmp_*

# Chip descriptions generated when a user imports a CMSIS-Pack. Keep the one
# family that is compiled into the executable via include_str!.
/targets/*.yaml
!/targets/HC32F4XX.yaml
